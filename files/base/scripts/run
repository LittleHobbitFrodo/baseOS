#!/bin/bash

source "$PWD/files/base/scripts.conf"

debug=false
system=""

parameters_file="$CONFIG_PATH/qemu-parameters.toml"



if [ "$#" != 0 ]; then
    for arg in "$@"; do
        i="$(echo $arg | tr '[:upper:]' '[:lower:]')"
        case $i in
            debug)
                debug=true
            ;;
            x86_64)
                system="$system x86_64"
            ;;
            arm64)
                system="$system aarch64"
            ;;
        esac
    done
fi

if [ -e "$parameters_file" ]; then

    if [ -n "$system" ]; then
        arch="$system"
    fi
    IFS=" "
    for i in $arch; do

        iso="$PWD/files/$iso_name-$i.iso"

        if [ ! -e "$iso" ]; then
            error "iso $iso_name-$i.iso does not exist"
            continue
        fi
        
        current_arch="$i"
        source "$(arch_config $i)"
        source "$parameters_file"

        $emulator $qemu_parameters

    done

else
    error "Qemu parameters are missing"
    note "please create the $(green "$parameters_file") file"
    exit 1
fi

