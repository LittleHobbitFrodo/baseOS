#!/bin/bash
source "$PWD/files/base/scripts.conf"


#   check and list targets
archs=""
debug=false
if [ "$#" != 0 ]; then
    for arg in "$@"; do
        a="$(echo $arg | tr '[:upper:]' '[:lower:]')"
        case $a in
            debug)
                debug=true
                ;;
            x86_64)
                archs="$archs x86_64"
            ;;
            arm64)
                archs="$archs aarch64"
            ;;
        esac
    done
else
    archs="$arch"
fi




cargo_params="--target-dir bin --verbose --target"




#   build for each target
IFS=" "
for a in $archs; do

    note "building kernel for $a target"

    #   load config for this target
    if [ -e "$(arch_config $a)" ]; then
        source $(arch_config $a)
    else
        error "configuration for $a target is missing"
        exit 2
    fi


    #   compile rust kernel
    cd ./kernel
        if [ "$debug" == true ]; then
            $compiler build $cargo_params "$(get_arch $a)-unknown-none"
        else
            $compiler build --release $cargo_params "$(get_arch $a)-unknown-none"
        fi

        if [ "$?" != 0 ]; then
            error "failed to compile kernel"
            exit 2
        fi

    cd ..

    #   copy compiled kernel into `files` directory
    cp $PWD/kernel/bin/$(get_arch $a)-unknown-none/release/baseOS $(kernel_full $a)

done