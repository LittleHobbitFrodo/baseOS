#!/bin/bash

source "$PWD/files/util/header.sh"

if [ "$#" -lt 1 ]; then
    #   arg count <= 1
    echo "$(red ERROR): no subcommand specified"
    exec "$PWD/files/util/help.sh"
    exit 1
fi

#set -eEuo pipefail

args="${@:1}"
subcmd=$1

IFS="+"
for i in $args; do

    #   delete spaces at the start and at the end
    i="${i#"${i%%[![:space:]]*}"}"   # remove leading
    i="${i%"${i##*[![:space:]]}"}"  # remove trailing

    IFS=" "
    subcmd="${i%% *}"   #   first word

    if [ "$(echo "$i" | wc -w)" -gt 1 ]; then
        #   has parameters
        cmd_args="${i#* }"
    else
        #   no parameters
        cmd_args=""
    fi

    case "$subcmd" in
        "--rebuild-util"|setup)
            if [ "$subcmd" = setup ]; then
                install_rustup notify
            else
                install_rustup
            fi
            build_scripts -vocal
        ;;
        help)
            exec "$PWD/files/util/help.sh" $cmd_args
        ;;
        *)
            #   other subcommands
            if [ -e "$PWD/files/util/commands/$subcmd" ]; then
                $PWD/files/util/commands/$subcmd $cmd_args

                case "$?" in
                    2)
                        #   internal error
                        error "subcommand $(blue "$subcmd") failed due to internal error"
                    ;;
                    1)
                        #   user error
                        exec "$PWD/files/util/help.sh" $subcmd
                    ;;
                esac

            else
                error "unknown subcommand \"$subcmd\""
                exec "$PWD/files/util/help.sh"
                exit $user_error
            fi
        ;;
    esac

    IFS="+"
done